
@article{kundu2026ed,
  title = {ED-Net: A hybrid deep learning framework for precise polyp segmentation integrating EfficientNetB0 with Double U-Net architecture and Atrous Spatial Pyramid Pooling with test-time augmentation},
  author = {Kundu, Rahul Kumar and Kibria, Hafsa Binte and Ahamed, Md Faysal and Chowdhury, Muhammad EH},
  journal = {Biomedical Signal Processing and Control},
  volume = {123},
  pages = {110566},
  year = {2026},
  publisher = {Elsevier},
  doi = {10.1016/j.bspc.2026.110566},
  url = {https://doi.org/10.1016/j.bspc.2026.110566},
  abbr = {BSPC},
  abstract = {Colorectal cancer (CRC) is a major global health concern, and colorectal polyps are early indicators of CRC. The precise and timely identification of these polyps is crucial for reducing CRC-related mortality rates. This study introduces a deep-learning-based segmentation framework, ED-Net, that incorporates a pretrained EfficientNetB0 encoder within a dual encoder–decoder architecture. This architecture is further enhanced by Atrous Spatial Pyramid Pooling (ASPP) for multi-scale feature extraction and squeeze-and-excitation (SE) blocks for adaptive channel-wise attention. Additionally, Test Time Augmentation (TTA) with horizontal and vertical flips was applied, which improved the interior and boundary segmentation accuracy through ensemble averaging. ED-Net was trained and tested on the Kvasir-SEG dataset, and to evaluate its generalization ability, cross-dataset evaluations were conducted on three benchmark datasets: CVC-ClinicDB, ETIS-LaribPolypDB, and PolypGen2021. ED-Net with TTA achieved an accuracy of 97.13%, a Dice Score of 92.26%, an IoU of 91.08%, a Frame per Second (FPS) of 12.93 with TTA and 47.17 without TTA on Kvasir-SEG, substantially outperforming the SOTA models in terms of accuracy and computational complexity. These results demonstrate that the model is effective, robust, and has potential for clinical deployment for the early detection of CRC.}
}



@inproceedings{sakib2025advancing,
  title = {Advancing Cybersecurity: A Study on Phishing Website Detection Using Machine Learning},
  author = {Sakib, Syed Nazmus and Jyoti, Oishi and Kundu, Rahul Kumar},
  booktitle = {2025 28th International Conference on Computer and Information Technology (ICCIT)},
  pages = {3530--3535},
  year = {2025},
  organization = {IEEE},
  doi = {10.1109/ICCIT68739.2025.11491653},
  url = {https://doi.org/10.1109/ICCIT68739.2025.11491653},
  abbr = {ICCIT},
  abstract = {Phishing attacks remain one of the most prevalent cybersecurity threats, often leading to financial loss and identity theft. Traditional detection mechanisms, such as blacklists or heuristic-based filters, are insufficient against zero-day phishing URLs and adversarial manipulation. This paper proposes a robust ensemble-based phishing website detection system that integrates XGBoost, LightGBM, CatBoost, and TabPFN, focusing exclusively on URL-based lexical and structural features. A Kaggle dataset of 11,055 samples was used, partitioned into 8,955 training and 2,100 testing instances. Preprocessing involved SelectKBest for feature selection, StandardScaler for normalization, and SMOTE for class balancing. Experimental evaluation shows the proposed ensemble achieves 93.3% accuracy and 0.99 recall, outperforming individual models while ensuring interpretability through SHAP (Shapley Additive Explanations). Results demonstrate that combining boosting techniques with modern tabular deep learning improves generalization and reliability, making the model suitable for real-time phishing detection.}
}



@inproceedings{prince2025beyond,
  title = {Beyond the Leaf: Intelligent Lightweight Disease Detection in Tea Plants with Spatial Convolutional Neural Networks and Explainable AI},
  author = {Prince, Reazul Hasan and Goni, Md Omaer Faruq and Peyal, Hasibul Islam and Kundu, Rahul Kumar},
  booktitle = {2025 IEEE 7th International Conference on Sustainable Technologies For Industry 5.0 (STI)},
  pages = {1--6},
  year = {2025},
  organization = {IEEE},
  doi = {10.1109/STI69347.2025.11367552},
  url = {https://doi.org/10.1109/STI69347.2025.11367552},
  abbr = {IEEE STI},
  abstract = {Tea is one of the classic beverages in Bangladesh. Since its demand and economic contribution are significant, our agronomists need to quickly find the diseases of tea and cure them. But the traditional process of finding tea diseases, such as recognizing the diseases by experts, is a very long process and difficult to find the type of disease. Furthermore, traditional methods for diagnosing these diseases depend on pathologists to identify symptoms simply by looking at them, which often results in a high rate of misdiagnosis and takes a long process to detect. For this purpose, a simple algorithm of the Convolutional Neural Network (CNN) has been proposed to eliminate the problem. Here, our proposed CNN model successfully classifies the six types of tea leaf diseases providing the accuracy of 99.23%. To evaluate the results, we also compared our model with two transfer learning models, MobileNetV2 and Xception, which achieved accuracies of 91.23% and 91.66%, respectively, on the same dataset. Moreover, the proposed method can effectively classify the classes with a significantly reduced number of parameters, resulting in a lightweight model. In addition, the model performance was measured using some excellent output curves and evaluation metrics, precision, recall, F1 score, confusion matrix, ROC, PR curve and MCC value. In addition, the GradCAM visualization method was used to explain the outcome of the proposed CNN model.}
}

